---
import '../styles/global.css';
import { gym } from '../config/site';
import logo from '../assets/logo marisol.png';

const questions = [
  ['lesion', '¿Presentás actualmente alguna lesión, dolor o molestia que pueda verse afectada por la actividad física?'],
  ['antecedente', '¿Tenés alguna enfermedad, condición o antecedente que pueda limitar el ejercicio?'],
  ['cirugia', '¿Tuviste recientemente una lesión, accidente, cirugía o período de inactividad relevante?'],
  ['medicacion', '¿Tomás alguna medicación que consideres importante informar?'],
  ['sintomas', '¿Tuviste mareos, desmayos, dolor de pecho o falta de aire inusual durante el ejercicio?'],
  ['embarazo', '¿Estás embarazada o existe posibilidad de embarazo?'],
];
---
<html lang="es">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={`Registro de ingreso y aceptación documental de ${gym.name}`} /><title>Registro de ingreso — {gym.name}</title></head>
  <body class="registration-page">
    <header class="site-header registration-header"><a class="brand logo-brand" href="/"><img src={logo.src} alt="Marisol Chavez Personal Trainer" /></a><a class="back-link" href="/">← Volver al inicio</a></header>
    <main class="registration-shell">
      <div class="registration-intro"><p class="eyebrow">INGRESO AL GIMNASIO <span>✦</span></p><h1>Tu entrenamiento<br /><em>empieza acá.</em></h1><p>Completá tus datos y leé el paquete documental antes de comenzar. Te enviaremos una copia del registro a tu correo y al correo institucional.</p><div class="steps"><span class="active">01 <small>Datos</small></span><i></i><span>02 <small>Salud</small></span><i></i><span>03 <small>Aceptación</small></span></div></div>
      <form class="registration-form" action={gym.formEndpoint} method="POST">
        <input type="hidden" name="_subject" value={`Nueva alta — ${gym.name}`} /><input type="hidden" name="_template" value="table" /><input type="hidden" name="_captcha" value="false" /><input type="hidden" name="_cc" value="" id="copy-email" /><input type="hidden" name="_next" value="/registro-gracias" />
        <section class="form-section step-panel" data-step="1"><div class="form-section-title"><span>01</span><div><h2>Datos personales</h2><p>Necesitamos esta información para identificar tu inscripción.</p></div></div><div class="field-grid"><label>Nombre y apellido *<input name="nombre" required autocomplete="name" /></label><label>DNI *<input name="dni" required inputmode="numeric" /></label><label>Fecha de nacimiento *<input name="fecha_nacimiento" type="date" required /></label><label>Teléfono *<input name="telefono" required type="tel" autocomplete="tel" /></label><label class="wide">Correo electrónico *<input name="email" id="member-email" required type="email" autocomplete="email" /><small>Recibirás una copia de tu registro en esta dirección.</small></label><label class="wide">Domicilio<input name="domicilio" autocomplete="street-address" /></label></div><div class="step-actions"><span>1 de 4</span><button type="button" class="button button-dark next-step">Continuar <span>→</span></button></div></section>
        <section class="form-section step-panel" data-step="2"><div class="form-section-title"><span>02</span><div><h2>Declaración previa de salud</h2><p>Respondé con sinceridad. Este cuestionario es preventivo y no reemplaza la consulta médica.</p></div></div><div class="health-questions">{questions.map(([name, label]) => <fieldset><legend>{label}</legend><div class="choice-row"><label><input type="radio" name={name} value="Sí" required /> Sí</label><label><input type="radio" name={name} value="No" /> No</label>{name === 'embarazo' && <label><input type="radio" name={name} value="No corresponde" /> No corresponde</label>}</div><textarea name={`${name}_detalle`} placeholder="Si respondiste sí, contanos brevemente (opcional)"></textarea></fieldset>)}</div><label class="wide extra-field">¿Hay otra circunstancia relacionada con tu estado físico que quieras informar?<textarea name="otra_circunstancia"></textarea></label><div class="step-actions"><button type="button" class="button button-light prev-step">← Atrás</button><span>2 de 4</span><button type="button" class="button button-dark next-step">Continuar <span>→</span></button></div></section>
        <section class="form-section step-panel" data-step="3"><div class="form-section-title"><span>03</span><div><h2>Contacto de emergencia</h2><p>Lo usaremos solo si ocurre una situación que requiera asistencia.</p></div></div><div class="field-grid"><label>Nombre y apellido *<input name="emergencia_nombre" required /></label><label>Vínculo *<input name="emergencia_vinculo" required placeholder="Ej. madre, pareja, amiga/o" /></label><label class="wide">Teléfono de emergencia *<input name="emergencia_telefono" required type="tel" /></label></div><div class="step-actions"><button type="button" class="button button-light prev-step">← Atrás</button><span>3 de 4</span><button type="button" class="button button-dark next-step">Continuar <span>→</span></button></div></section>
        <section class="form-section step-panel" data-step="4"><div class="form-section-title"><span>04</span><div><h2>Leé y aceptá el paquete</h2><p>Estas casillas dejan constancia de que recibiste la información y comprendés las reglas del gimnasio.</p></div></div><div class="document-box"><details open><summary>Documento 1 · Convenio y consentimiento informado</summary><p>Reconocés los riesgos propios de la actividad física, te comprometés a informar lesiones o molestias, utilizar correctamente las instalaciones y seguir las indicaciones del personal. Esta aceptación no implica renuncia a derechos legales.</p></details><details><summary>Documento 2 · Declaración previa de salud</summary><p>Declarás que las respuestas de este formulario son verdaderas y completas según tu leal saber y entender. Entendés que es un formulario preventivo y no constituye diagnóstico médico.</p></details><details><summary>Documento 3 · Reglamento interno</summary><p>Te comprometés a respetar las indicaciones, usar máquinas y cargas de forma adecuada, informar desperfectos, interrumpir el ejercicio ante dolor o malestar y mantener hidratación y vestimenta apropiadas.</p></details></div><label class="check-line"><input type="checkbox" name="recibi_documentos" required /> Confirmo que recibí, leí y comprendí los Documentos 1, 2 y 3 del paquete documental.</label><label class="check-line"><input type="checkbox" name="acepto_reglamento" required /> Acepto el convenio, la declaración de salud y el reglamento interno de {gym.name}.</label><label class="check-line"><input type="checkbox" name="datos_veraces" required /> Declaro que los datos y respuestas enviados son verdaderos y me comprometo a informar cualquier cambio relevante.</label><fieldset class="image-consent"><legend>¿Autorizás el uso de tu imagen en redes y comunicaciones del gimnasio?</legend><div class="choice-row"><label><input type="radio" name="uso_imagen" value="Sí, autorizo" required /> Sí, autorizo</label><label><input type="radio" name="uso_imagen" value="No autorizo" /> No autorizo</label></div></fieldset><div class="step-actions"><button type="button" class="button button-light prev-step">← Atrás</button><span>4 de 4</span><button class="button button-dark" type="submit">Enviar mi registro <span>↗</span></button></div></section>
        <div class="form-submit"><p>Al enviar, se generará una constancia para vos y para el gimnasio.</p></div>
      </form>
    </main>
    <footer><div class="footer-bottom"><span>© 2024 {gym.name}</span><a href={gym.instagram} target="_blank" rel="noreferrer">Instagram ↗</a><a href="/">Volver al inicio ↑</a></div></footer>
    <a class="whatsapp-float" href="https://wa.me/5492664644901?text=Hola%20Marisol%2C%20quiero%20consultar%20por%20entrenamiento%20personalizado" target="_blank" rel="noreferrer" aria-label="Contactar por WhatsApp"><span>◔</span><b>WhatsApp</b></a>
    <script>
      const email = document.querySelector('#member-email'); const copy = document.querySelector('#copy-email');
      email?.addEventListener('input', () => { copy.value = email.value; });
      document.querySelector('form')?.addEventListener('submit', () => { copy.value = email.value; });
      const panels = [...document.querySelectorAll('.step-panel')]; const indicators = [...document.querySelectorAll('.steps span')]; let current = 0;
      const showStep = (index) => { current = index; panels.forEach((panel, i) => panel.classList.toggle('is-active', i === current)); indicators.forEach((item, i) => item.classList.toggle('active', i === current)); window.scrollTo({ top: 0, behavior: 'smooth' }); };
      document.querySelectorAll('.next-step').forEach(button => button.addEventListener('click', () => { const panel = button.closest('.step-panel'); const required = [...panel.querySelectorAll('input[required], select[required], textarea[required]')]; if (required.some(field => !field.checkValidity())) { panel.querySelector(':invalid')?.reportValidity(); return; } showStep(Math.min(current + 1, panels.length - 1)); }));
      document.querySelectorAll('.prev-step').forEach(button => button.addEventListener('click', () => showStep(Math.max(current - 1, 0)))); showStep(0);
    </script>
  </body>
</html>
